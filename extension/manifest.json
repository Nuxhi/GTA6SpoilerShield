{
  "manifest_version": 3,
  "name": "GTA 6 Spoiler Shield",
  "version": "1.3.0",
  "description": "Masque automatiquement les contenus pouvant spoiler GTA VI (X, Reddit, YouTube, TikTok, Instagram, Facebook, Google…). 100 % local.",
  "minimum_chrome_version": "110",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GTA 6 Spoiler Shield",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://mail.google.com/*",
        "*://docs.google.com/*",
        "*://drive.google.com/*",
        "*://accounts.google.com/*",
        "*://calendar.google.com/*",
        "*://meet.google.com/*",
        "*://myaccount.google.com/*"
      ],
      "js": [
        "keywords.js",
        "matcher.js",
        "util.js",
        "whitelist.js",
        "sites/generic.js",
        "sites/x.js",
        "sites/reddit.js",
        "sites/youtube.js",
        "sites/tiktok.js",
        "sites/instagram.js",
        "sites/facebook.js",
        "sites/google.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
